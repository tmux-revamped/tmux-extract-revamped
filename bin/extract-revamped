#!/bin/sh
[ -n "${ZSH_VERSION:-}" ] && emulate sh
set -eu

extract_revamped_self="$0"
case "${extract_revamped_self}" in
*/*) ;;
*) extract_revamped_self="$(command -v -- "${extract_revamped_self}")" ;;
esac
extract_revamped_lib="$(cd "${extract_revamped_self%/*}/../lib" && pwd)" || exit 1
for extract_revamped_inherited in $(env | sed -n -e 's/^\(REVAMPED_[A-Za-z0-9_]*\)=.*/\1/p' -e 's/^\(EXTRACT_REVAMPED_[A-Za-z0-9_]*_LOADED\)=.*/\1/p'); do
  case "${extract_revamped_inherited}" in
  REVAMPED_TEST_*) continue ;;
  *) unset "${extract_revamped_inherited}" ;;
  esac
done
REVAMPED_LIB="${extract_revamped_lib}"

# shellcheck source=SCRIPTDIR/../lib/core.sh
. "${REVAMPED_LIB}/core.sh"
# shellcheck source=SCRIPTDIR/../lib/extract.sh
. "${REVAMPED_LIB}/extract.sh"

extract_revamped_interface() {
  # shellcheck disable=SC2034
  REVAMPED_UI_NAME=extract-revamped REVAMPED_UI_VERSION="${EXTRACT_REVAMPED_VERSION}" REVAMPED_UI_TAGLINE="a token off the screen, at the cursor"
  if [ -n "${EXTRACT_REVAMPED_ACCENT:-}" ]; then
    # shellcheck disable=SC2034
    REVAMPED_UI_ACCENT_CHOICE="${EXTRACT_REVAMPED_ACCENT}" REVAMPED_UI_ACCENT_NAME=EXTRACT_REVAMPED_ACCENT
  fi
  # shellcheck source=SCRIPTDIR/../lib/cli.sh
  . "${REVAMPED_LIB}/cli.sh"
  # shellcheck source=SCRIPTDIR/../lib/doctor.sh
  . "${REVAMPED_LIB}/doctor.sh"
}

extract_revamped_usage() {
  extract_revamped_interface
  revamped_cli_usage_error "$1"
}

extract_revamped_help() {
  revamped_cli_help_page <<'HELP'
extract-revamped - pick a token off the screen and type, open or copy it

usage:
  extract-revamped apply            bind the keys now
  extract-revamped list             print every binding apply would make
  extract-revamped insert [PANE]    pick a token and type it into PANE
  extract-revamped navigate [PANE]  pick a token and find it in PANE's
                                    copy-mode
  extract-revamped open [PANE]      pick a token and open it: a URL in the
                                    browser, a path in $EDITOR
  extract-revamped copy [PANE]      pick a token and copy it
  extract-revamped choose [PANE]    pick in a chooser: Enter types, C-o opens,
                                    C-y copies, C-n changes the mode
  extract-revamped doctor           check this machine
  extract-revamped version          print the version
  extract-revamped help             print this page

options:
  --json           list prints one JSON object
  --theme NAME     the look: kodougu, catppuccin-mocha, catppuccin-latte,
                   dracula, nord, gruvbox, tokyo-night or mono
  --SETTING VALUE  any tmux option below, named with dashes, such as
                   --mode urls or --min-length 4

environment:
  EXTRACT_REVAMPED_SETTING  any tmux option below in capitals, such as
                            EXTRACT_REVAMPED_MODE
  EXTRACT_REVAMPED_THEME    the look, when --theme is not given
  EXTRACT_REVAMPED_ACCENT   a colour such as #CBA6F7 for the accent
  KODOUGU_THEME             the family look, when neither is given
  KODOUGU_ACCENT            the family accent, when the tool's is unset
  NO_COLOR                  turn colour off

tmux options:
  @extract_revamped_key            prefix key of the picker; none for no key
                                   (M-x)
  @extract_revamped_navigate_key   key of the navigate picker (unbound)
  @extract_revamped_open_key       key of the open picker (unbound)
  @extract_revamped_copy_key       key of the copy picker (unbound)
  @extract_revamped_chooser_key    key of the chooser (unbound)
  @extract_revamped_doctor_key     key of the doctor report (unbound)
  @extract_revamped_mode           what to pick: all, urls, paths, words,
                                   lines, shas, ipv4, ipv6, hex, uuids,
                                   numbers, quoted, bracketed or custom (all)
  @extract_revamped_modes          modes C-n cycles in the chooser
                                   (all urls paths words lines)
  @extract_revamped_scope          pane, all-panes or last-log (pane)
  @extract_revamped_log_dir        folder last-log reads the newest file of
                                   (~/.tmux/logging-revamped)
  @extract_revamped_custom_regex   extended regex of the custom mode (none)
  @extract_revamped_min_length     drop shorter tokens (0)
  @extract_revamped_reverse        1 puts the last match first (0)
  @extract_revamped_multi          1 lets fzf mark several tokens (0)
  @extract_revamped_osc52          1 copies with OSC 52 (0)
  @extract_revamped_frecency       1 puts recent picks first (0)
  @extract_revamped_lines          scrollback lines read above the screen
                                   (200)
  @extract_revamped_popup_width    popup width (80%)
  @extract_revamped_popup_height   popup height (60%)
  @revamped_theme                  the family look (kodougu)

notes:
  The entry point runs apply once when tmux loads the plugin, and every
  binding goes to tmux in one call. A key opens a popup that runs one of the
  pick commands; without PANE they read the client's active pane, the one
  under the popup, since tmux expands no format in a popup's command. A
  setting given as a tmux option is read when a pick runs; one given to apply
  on the command line or in the environment rides on the keys it binds. A
  picked token is typed with send-keys -l, so it reaches the pane as literal
  text. With frecency on, the last 20 picks are kept in
  @extract_revamped_recent.

examples:
  extract-revamped list
  extract-revamped --mode urls insert %1
  extract-revamped doctor
HELP
}

extract_revamped_version() {
  extract_revamped_tmux=$(tmux -V 2>/dev/null) || extract_revamped_tmux=missing
  printf '%s %s\n' extract-revamped "${EXTRACT_REVAMPED_VERSION}"
  printf 'tmux: %s\n' "${extract_revamped_tmux#tmux }"
}

extract_revamped_doctor_optional() {
  if [ -n "$2" ]; then
    revamped_doctor_line "$1" ok "$2"
    return 0
  fi
  revamped_doctor_line "$1" warn "$3"
}

extract_revamped_doctor() {
  revamped_doctor_tmux
  revamped_doctor_required fzf "brew install fzf, or apt install fzf"
  extract_revamped_doctor_opener=$(extract_revamped_opener)
  extract_revamped_doctor_optional opener "${extract_revamped_doctor_opener}" "open needs xdg-open or open"
  extract_revamped_doctor_clipboard=$(extract_revamped_clipboard)
  extract_revamped_doctor_optional clipboard "${extract_revamped_doctor_clipboard}" "copy needs pbcopy, wl-copy, xclip or xsel, or @extract_revamped_osc52"
  extract_revamped_doctor_base64=$(command -v base64 2>/dev/null) || extract_revamped_doctor_base64=""
  extract_revamped_doctor_optional base64 "${extract_revamped_doctor_base64}" "OSC 52 copies need base64"
  extract_revamped_plan
  [ -z "${EXTRACT_REVAMPED_TAKEN}" ] || revamped_doctor_line "prefix ${EXTRACT_REVAMPED_TAKEN}" warn "already bound, so the picker has no key; set @extract_revamped_key"
  revamped_doctor_gum
  revamped_doctor_core_tools awk sed grep tr
  revamped_doctor_finish
  [ "${REVAMPED_DOCTOR_MISSING}" -eq 0 ] || exit 1
}

extract_revamped_list() {
  extract_revamped_plan
  if [ -n "${extract_revamped_json}" ]; then
    extract_revamped_json
    return 0
  fi
  extract_revamped_lines_of_plan
}

extract_revamped_apply_command() {
  extract_revamped_apply
  extract_revamped_count=$(extract_revamped_bindings)
  printf 'Applied. %s keys are bound.\n' "${extract_revamped_count}"
}

extract_revamped_menu() {
  revamped_cli_require_terminal
  extract_revamped_choice=$(revamped_cli_menu "List the bindings" "Apply them now" "Check this machine" "Help")
  case "${extract_revamped_choice}" in
  "List the bindings") extract_revamped_list ;;
  "Apply them now") extract_revamped_apply_command ;;
  "Check this machine") extract_revamped_doctor ;;
  *) extract_revamped_help ;;
  esac
}

extract_revamped_dispatch() {
  case "${1:-}" in
  doctor) extract_revamped_doctor ;;
  version | --version | -V) extract_revamped_version ;;
  help | --help | -h) extract_revamped_help ;;
  list) extract_revamped_list ;;
  "") extract_revamped_menu ;;
  *) revamped_cli_usage_error "unknown command '$1'" ;;
  esac
}

extract_revamped_known() {
  [ "$1" != --theme ] || return 0
  extract_revamped_known_name=$(extract_revamped_setting_name "$1")
  [ -n "${extract_revamped_known_name}" ] || extract_revamped_usage "unknown option '$1'"
}

extract_revamped_set() {
  extract_revamped_set_upper=$(printf '%s\n' "$1" | tr '[:lower:]' '[:upper:]')
  export "EXTRACT_REVAMPED_${extract_revamped_set_upper}=$2"
}

extract_revamped_option() {
  extract_revamped_option_name=$(extract_revamped_setting_name "$1")
  [ -n "${extract_revamped_option_name}" ] || extract_revamped_usage "unknown option '$1'"
  extract_revamped_set "${extract_revamped_option_name}" "$2"
}

extract_revamped_main() {
  extract_revamped_theme="${EXTRACT_REVAMPED_THEME:-}" extract_revamped_json="" extract_revamped_count=$# extract_revamped_rest=0
  while [ "${extract_revamped_count}" -gt 0 ]; do
    extract_revamped_arg="$1"
    shift
    extract_revamped_count=$((extract_revamped_count - 1))
    case "${extract_revamped_rest}:${extract_revamped_arg}" in
    1:*) set -- "$@" "${extract_revamped_arg}" ;;
    0:--) extract_revamped_rest=1 ;;
    0:--json) extract_revamped_json=1 ;;
    0:-h | 0:-V | 0:--help | 0:--version) set -- "$@" "${extract_revamped_arg}" ;;
    0:--theme=*) extract_revamped_theme="${extract_revamped_arg#--theme=}" ;;
    0:--*=*) extract_revamped_option "${extract_revamped_arg%%=*}" "${extract_revamped_arg#*=}" ;;
    0:--*)
      extract_revamped_known "${extract_revamped_arg}"
      [ "${extract_revamped_count}" -gt 0 ] || extract_revamped_usage "option '${extract_revamped_arg}' needs a value"
      if [ "${extract_revamped_arg}" = --theme ]; then
        extract_revamped_theme="$1"
      else
        extract_revamped_option "${extract_revamped_arg}" "$1"
      fi
      shift
      extract_revamped_count=$((extract_revamped_count - 1))
      ;;
    0:-?*) extract_revamped_usage "unknown option '${extract_revamped_arg}'" ;;
    *) set -- "$@" "${extract_revamped_arg}" ;;
    esac
  done
  extract_revamped_run "${extract_revamped_theme}" "$@"
}

extract_revamped_run() {
  extract_revamped_run_theme="$1"
  shift
  [ -z "${extract_revamped_json}" ] || [ "${1:-}" = list ] || extract_revamped_usage "option '--json' works only with list"
  case "${1:-}" in
  apply) extract_revamped_apply ;;
  insert | navigate | open | copy | choose) extract_revamped_pick "$1" "${2:-}" ;;
  *)
    extract_revamped_interface
    revamped_cli_start "${extract_revamped_run_theme}"
    extract_revamped_dispatch "$@"
    ;;
  esac
}

extract_revamped_main "$@"
